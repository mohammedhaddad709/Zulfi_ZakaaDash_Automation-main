test-execution-reports/
test-output/
video/
.staging/
__pycache__/
*.pyc

# Bundled Allure CLI binary (40 MB) - install locally (scripts/install-allure-local.ps1) or set ALLURE_CLI
tools/allure-*/

# Local credentials / IDE
.env
*.local.properties
.idea/
.vscode/
*.iml

# Local credentials (never commit)
config/credentials.local.properties
