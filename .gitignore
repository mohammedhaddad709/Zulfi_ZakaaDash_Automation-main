# Build and run output
target/
runner/runs/
runner/.build/
runner/.runner.lock
runner/runner.pid
runner/.tmp/
runner/.archive-cache.json
runner/.archive-cache.tmp
# Runner results/state (FileStore): defect registry, schedules, Systems-page edits, quarantine, uptime, Claude, jobs
runner/bugs.json
runner/schedules.json
runner/config-store.json
runner/quarantine.json
runner/uptime.jsonl
runner/agent/
runner/jobs/
