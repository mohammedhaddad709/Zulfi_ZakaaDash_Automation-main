            <class name="com.taf.systems.zulfi.config.MatchScheduleAnalysisGateContractTest"/>
            <class name="com.taf.systems.zulfi.features.analysis.OfficialFixturePreflightTest"/>
            <class name="com.taf.systems.zulfi.features.analysis.OfficialFixtureSelectionTest"/>
