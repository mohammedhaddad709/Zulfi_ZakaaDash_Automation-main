            <class name="com.taf.systems.zulfi.features.matchschedule.MatchScheduleBrowseAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.login.LoginRegressionSuiteGuardContractTest"/>
            <class name="com.taf.systems.zulfi.reporting.DefectReportingContractTest"/>
            <class name="com.taf.systems.zulfi.validations.DuplicateFixtureToastRulesTest"/>
            <class name="com.taf.systems.zulfi.validations.TeamFieldDisplayRulesTest"/>
        </classes>
    </test>
</suite>
