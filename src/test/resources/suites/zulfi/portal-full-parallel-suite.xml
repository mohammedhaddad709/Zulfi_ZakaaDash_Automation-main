            <class name="com.taf.systems.zulfi.features.analysis.friendly.FriendlyMatchAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.analysis.listing.AnalysesListingAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.analysis.matchtype.MatchTypeOfficialAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.analysis.status.AnalysisProcessingStatusAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.clubinfo.ClubInformationAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.clubs.ClubsBrowseAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.home.HomeCurrentResultsAcceptanceTest"/>
            <class name="com.taf.systems.zulfi.features.home.HomeOverviewAcceptanceTest"/>
