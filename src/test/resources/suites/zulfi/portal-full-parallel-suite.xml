<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Run: scripts/run-portal-full-parallel.ps1 (MCH-ANL submit chain: match-schedule-analysis-submit-suite.xml, explicit authorization only) -->
