<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  US-FAP-MCH-ANALYSIS (33009) — AUTHORIZED SUBMIT: MCH-ANL-010 (+ grouped 011, 012 and, with the duplicate probe, 014, 015, 016).
  Creates ONE real analysis and consumes one «غير محللة» match. Required flags:
    -Dmatch.schedule.analysis.phase=c -Danalysis.create.enabled=true -Dmatch.schedule.analysis.submit.enabled=true
  Optional: -Dmatch.schedule.analysis.targetExternalEventId=<id>   pin the match (never switches silently)
            -Dmatch.schedule.analysis.duplicateCheck.enabled=true  submit a stale second form once; it MUST be rejected
            -Dreport.video=ALWAYS                                  keep the video even when the run passes
-->
<suite name="Match Schedule Official Analysis — submit" verbose="1" parallel="false">
    <test name="MCH-ANL authorized submit">
        <classes>
            <class name="com.taf.systems.zulfi.features.matchschedule.MatchScheduleAnalysisAcceptanceTest">
                <methods>
                    <include name="mchAnl010_submitCreatesOneLinkedAnalysisAndRejectsDuplicates"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
