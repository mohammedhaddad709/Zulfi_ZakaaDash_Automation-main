<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Non-mutating smoke: discovery + user-flow label selection (no index sweep unless -Danalysis.fixture.selection.indexMode=true) -->
<suite name="Official Fixture Selection Smoke" verbose="1" parallel="false">
    <test name="Fixture Discovery">
        <classes>
            <class name="com.taf.systems.zulfi.features.analysis.OfficialFixtureDiscoveryTest"/>
        </classes>
    </test>
    <test name="User Flow Selection Smoke">
        <classes>
            <class name="com.taf.systems.zulfi.features.analysis.OfficialFixtureSelectionTest">
                <methods>
                    <include name="verifyOfficialFixtureSelectionUserFlowSmoke"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
