<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ZakaaDash - Regression" verbose="1">
    <test name="Feature Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.taf.systems.zakaadash.tests.auth"/>
            <package name="com.taf.systems.zakaadash.tests.dataversions"/>
            <package name="com.taf.systems.zakaadash.tests.upload"/>
            <package name="com.taf.systems.zakaadash.tests.preprocessing.*"/>
        </packages>
    </test>
    <test name="E2E Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.taf.systems.zakaadash.tests.e2e"/>
        </packages>
    </test>
</suite>
