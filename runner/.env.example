# Copy to runner/.env (git-ignored). KEY=VALUE per line; a variable already set in the environment wins.
# Every setting is optional: without any of them the runner uses JSON files and local reports.

# --- server
# RUNNER_HOST=127.0.0.1
# RUNNER_PORT=8080
# RUNNER_USER=admin
# RUNNER_PASSWORD=change-me            # enables Basic auth (required when RUNNER_HOST is not 127.0.0.1)
# RUNNER_MAX_PARALLEL=4
# RUNNER_EXECUTION=LocalHeadless       # default browser mode in the form: LocalHeadless | Local | Remote
# RUNNER_ALLOWED_HOSTS=runner.company.com
# RUNNER_JVM_ARGS=-Xmx2g
# MVN=C:\Tools\apache-maven-3.9.16\bin\mvn.cmd
# JAVA_HOME=C:\Program Files\Java\jdk-21
# ALLURE_CLI=E:\Zulfi_ZakaaDash_Automation-main\tools\allure-2.29.0\bin\allure.bat

# --- MySQL results storage (first start imports runner/runs, bugs.json, schedules.json)
# RUNNER_DB_HOST=localhost
# RUNNER_DB_PORT=3306
# RUNNER_DB_USER=runner
# RUNNER_DB_PASSWORD=
# RUNNER_DB_NAME=automation_runner
# RUNNER_DB_SSL_CA=/path/ca.pem
# RUNNER_DB_SSL=required

# --- vault: key for enc:v1: values (python runner/vault.py --new-key); the runner itself never stores passwords
# RUNNER_SECRET_KEY=

# --- DigitalOcean Spaces report storage
# RUNNER_SPACES_KEY=
# RUNNER_SPACES_SECRET=
# RUNNER_SPACES_BUCKET=
# RUNNER_SPACES_REGION=fra1
# RUNNER_SPACES_PREFIX=automation-runner
# RUNNER_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# --- Gmail notifications (Google app password, not the account password)
# RUNNER_GMAIL_USER=qa.bot@gmail.com
# RUNNER_GMAIL_APP_PASSWORD=
# RUNNER_PUBLIC_URL=http://localhost:8080

# --- Claude Code
# RUNNER_CLAUDE=claude
# RUNNER_AGENT_MODEL=
# RUNNER_AGENT_BUDGET_USD=5
# RUNNER_AGENT_WORK=E:\.runner-agent
# RUNNER_AGENT_TOOLS=Read,Grep,Glob,Edit,Write,Bash(mvn *),Bash(python tools/*),Bash(git status*),Bash(git diff*)
# ANTHROPIC_API_KEY=

# --- update from GitHub (disabled until a repository is set)
# RUNNER_GITHUB_REPO=owner/name
# RUNNER_GITHUB_BRANCH=main
# RUNNER_GITHUB_TOKEN=
# RUNNER_ALLOW_UPDATE=1

# --- reliability
# RUNNER_FLAKY_AUTO=1
# RUNNER_FLAKY_FLIPS=3
# RUNNER_FLAKY_WINDOW=8
# RUNNER_FLAKY_STABLE=5
# RUNNER_ENV_RETRIES=3
# RUNNER_ENV_RETRY_MINUTES=10
# RUNNER_UPTIME_EVERY=300
# RUNNER_UPTIME=1
