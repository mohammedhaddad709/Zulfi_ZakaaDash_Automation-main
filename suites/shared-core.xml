<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Shared-core contract tests (no browser). Not system-specific, so not generated by tools/gen_suites.py. -->
<suite name="Shared core contracts" verbose="1" parallel="false">
    <test name="Configuration and output isolation">
        <classes>
            <class name="com.taf.core.SharedCoreConfigTest"/>
        </classes>
    </test>
    <test name="Runner integration (vault, timing retry)">
        <classes>
            <class name="com.taf.core.utils.dataReader.SecretVaultTest"/>
            <class name="com.taf.core.listeners.TimingRetryTest"/>
        </classes>
    </test>
</suite>
